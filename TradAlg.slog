% Comenzamos declarando los tipos.
% Los tipos basicos no hace falta que sean declarados.
% Empiezan con minuscula ya que son constantes.


parameters([Delta, SumSet, SelectTop3]).       

variables([MarketActions, ActualActions, State, Check]).


%Cada una de estas son cláusulas.

% Sinonimos de tipo
def_type(value, int).                                                  
def_type(alpha, int).
def_type(actions, rel(stock, [value,alpha])).                         

def_type(algstate, enum([analyzing, buying])).                           
def_type(msj, enum([                                                    
    ok,
    errorBuyingInProcess,
    errorNotFunds,
    errorGettingActions,
    errorActActionsActualActionsNotPresent,
    errorTimeToCheck,
    errorCheckingDuringBuying,
    errorCheckingDeltaNotReached,
    errorBuyActionNotBuying,
    errorBuyActionNotFounds,
    errorBuyActionDeltaError,
    errorBuyActionSelectTop3
])).

% Axiomas

axiom(axm1).                                                            
dec_p_type(axm1(int)).                                                  
axm1(Delta) :- Delta > 0.                                               

axiom(axm2).                                                            
dec_p_type(axm2(rel(set(value),value))).                                     
axm2(SumSet) :- pfun(SumSet).

axiom(axm3).                                                            
dec_p_type(axm3(rel(actions,set(stock)))).                              
axm3(SelectTop3) :- pfun(SelectTop3).                                   


invariant(invAlg).
dec_p_type(invAlg(actions, set(stock), int)).
invAlg(MarketActions, ActualActions, Check):-

    % Estructural
    pfun(MarketActions) &

    let([DomMkt],
        ( dom(MarketActions, DomMkt) &
          dec(DomMkt, set(stock))
        ),
        subset(ActualActions, DomMkt)
    ) &

    Check >= 0.


%invariant(invAct).
%dec_p_type(invAct(actions)).
%invAct(NewMktActions) :-
%    pfun(NewMktActions).

% Estado inicial
initial(initAlg).
dec_p_type(initAlg(actions, set(stock), algstate, int)).
initAlg(MarketActions, ActualActions, State, Check) :- 
    pfun(MarketActions) &
    ActualActions = {} & 
    State = analyzing &
    Check = 0.


%%%%%%%%%%%%%%%%%%%% ActActions %%%%%%%%%%%%%%%%%%%%%%%
% ActActionsOk
% No es necesario nombrar a las variables que no se usan (MarketActions).
% En su caso, se usan únicamente las primadas.

dec_p_type(actActionsOk(set(stock), algstate, int, actions, actions, set(stock), algstate, int, msj, int)).
actActionsOk(ActualActions, State, Check, NewMktActions, MarketActions_, ActualActions_, State_, Check_, Msj, Delta)  :-
    
    pfun(NewMktActions) & 
    
    State = analyzing & 

    % #NewMktActions? >= 3
    let([SMKT],
        ( size(NewMktActions, SMKT) & dec(SMKT, int) ),
        SMKT >= 3) & 

    Check =< Delta &

    % Las nuevas acciones deben contener a las que tengo
    dom(NewMktActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    subset(ActualActions, DomMkt) &

    MarketActions_ = NewMktActions &
    ActualActions_ = ActualActions &
    State_ = State &
    Check_ is Check + 1 &
    Msj = ok.

%ActActionsErrorBuyInProgress
dec_p_type(actActionsErrorBuyInProgress(actions, set(stock), algstate, int, msj, int)).
actActionsErrorBuyInProgress(NewMktActions, ActualActions, State, Check, Msj, Delta) :-
    pfun(NewMktActions) & 

    State = buying &
    Check =< Delta &
    size(NewMktActions, SMKT) &
    dec(SMKT, int) &
    SMKT >= 3 &
    dom(NewMktActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    subset(ActualActions, DomMkt) &

    Msj = errorBuyingInProcess.

%ActActionsErrorGettingActions
dec_p_type(actActionsErrorGettingActions(actions, set(stock), algstate, int, msj, int)).
actActionsErrorGettingActions(NewMktActions, ActualActions, State, Check, Msj, Delta) :-
    pfun(NewMktActions) & 

    State = analyzing &
    Check =< Delta &
    size(NewMktActions, SMKT) &
    dec(SMKT, int) &
    SMKT < 3 &
    % dom(NewMktActions, DomMkt) &
    % dec(DomMkt, set(stock)) &
    % subset(ActualActions, DomMkt) &

    Msj = errorGettingActions.

%ActActionsErrorTimeToCheck
dec_p_type(actActionsErrorTimeToCheck(actions, set(stock), algstate, int, msj, int)).
actActionsErrorTimeToCheck(NewMktActions, ActualActions, State, Check, Msj, Delta) :-
    pfun(NewMktActions) & 

    State = analyzing &
    Check > Delta &
    size(NewMktActions, SMKT) &
    dec(SMKT, int) &
    SMKT >= 3 &

    dom(NewMktActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    subset(ActualActions, DomMkt) &

    Msj = errorTimeToCheck.

%ActActionsErrorActualActionsNotPresent
dec_p_type(actActionsErrorActualActionsNotPresent(actions, set(stock), algstate, int, msj, int)).
actActionsErrorActualActionsNotPresent(NewMktActions, ActualActions, State, Check, Msj, Delta):-
    pfun(NewMktActions) & 

    State = analyzing &
    Check =< Delta &
    size(NewMktActions, SMKT) &
    dec(SMKT, int) &
    SMKT >= 3 &

    dom(NewMktActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    nsubset(ActualActions, DomMkt) &

    Msj = errorActActionsActualActionsNotPresent.

dec_p_type(actActions_error_case(actions, set(stock), algstate, int, actions, actions, set(stock), algstate, int, msj, int)).
actActions_error_case(MarketActions, ActualActions, State, Check, NewMktActions,
                      MarketActions_, ActualActions_, State_, Check_, Msj, Delta) :-
    ( actActionsErrorBuyInProgress(NewMktActions, ActualActions, State, Check, Msj, Delta)
      or actActionsErrorGettingActions(NewMktActions, ActualActions, State, Check, Msj, Delta)
      or actActionsErrorTimeToCheck(NewMktActions, ActualActions, State, Check, Msj, Delta)
      or actActionsErrorActualActionsNotPresent(NewMktActions, ActualActions, State, Check, Msj, Delta)
    ) &
    MarketActions_ = MarketActions &
    ActualActions_ = ActualActions &
    State_ = State &
    Check_ = Check. 

% --- Ahora la operación ---
operation(actActions).
dec_p_type(actActions(actions, set(stock), algstate, int, actions, actions, set(stock), algstate, int, msj, int)).
actActions(MarketActions, ActualActions, State, Check, NewMktActions,
           MarketActions_, ActualActions_, State_, Check_, Msj, Delta) :-
    actActionsOk(ActualActions, State, Check, NewMktActions, MarketActions_, ActualActions_, State_, Check_, Msj, Delta)
    or
    actActions_error_case(MarketActions, ActualActions, State, Check, NewMktActions,
                          MarketActions_, ActualActions_, State_, Check_, Msj, Delta).

        
%%%%%%%%%%%%%%%%%%%% ActActions %%%%%%%%%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%%%%%%% CheckMarket %%%%%%%%%%%%%%%%%%%%%%%
%CheckMarketToBuyOk
dec_p_type(checkMarketToBuyOk(algstate, int, actions, set(stock), actions, set(stock), algstate, int, msj, rel(actions,set(stock)), int)).
checkMarketToBuyOk(State, Check, MarketActions, ActualActions, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, Delta):- 
    State = analyzing & 
    Check > Delta &

    applyTo(SelectTop3, MarketActions, S) &
    dec(S, set(stock)) &
    S neq ActualActions &

    MarketActions_ = MarketActions &
    ActualActions_ = ActualActions &
    State_ = buying &
    Check_ = 0 &
    Msj = ok.

%CheckMarketNotBuyOk -> La no-compra de acciones es un paso de ejecución permitido.
dec_p_type(checkMarketNotBuyOk(algstate, int, actions, set(stock), actions, set(stock), algstate, int, msj, rel(actions,set(stock)), int)).
checkMarketNotBuyOk(State, Check, MarketActions, ActualActions, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, Delta):- 
    State = analyzing & 
    Check > Delta &
    
    applyTo(SelectTop3, MarketActions, S) &
    dec(S, set(stock)) &
    S = ActualActions &
    
    MarketActions_ = MarketActions &
    ActualActions_ = ActualActions &
    State_ = State &
    Check_ = 0 &
    Msj = ok.

%CheckMarketToBuyErrorBuying
dec_p_type(checkMarketToBuyErrorBuying(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), int)).
checkMarketToBuyErrorBuying(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta):-
    State = buying &
    Check > Delta &

    applyTo(SelectTop3, MarketActions, S) &
    dec(S, set(stock)) &
    S neq ActualActions &

    Msj = errorCheckingDuringBuying.


%CheckMarketToBuyErrorDelta
dec_p_type(checkMarketToBuyErrorDelta(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), int)).
checkMarketToBuyErrorDelta(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta):-
    State = analyzing &
    Check =< Delta &
    
    applyTo(SelectTop3, MarketActions, S) &
    dec(S, set(stock)) &
    S neq ActualActions &

    Msj = errorCheckingDeltaNotReached.


%CheckMarketNotBuyErrorBuying
dec_p_type(checkMarketNotBuyErrorBuying(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), int)).
checkMarketNotBuyErrorBuying(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta):-
    State = buying &
    Check > Delta &

    applyTo(SelectTop3, MarketActions, S) &
    dec(S, set(stock)) &
    S = ActualActions &

    Msj = errorCheckingDuringBuying.


%CheckMarketNotBuyErrorDelta
dec_p_type(checkMarketNotBuyErrorDelta(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), int)).
checkMarketNotBuyErrorDelta(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta):-
    State = analyzing &
    Check =< Delta &

    applyTo(SelectTop3, MarketActions, S) &
    dec(S, set(stock)) &
    S = ActualActions &
    
    Msj = errorCheckingDeltaNotReached.

dec_p_type(checkMarketErrors(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), int, actions, set(stock), algstate, int)).
checkMarketErrors(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta, MarketActions_, ActualActions_, State_, Check_):-
    (checkMarketToBuyErrorBuying(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta) or 
        checkMarketToBuyErrorDelta(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta) or 
        checkMarketNotBuyErrorBuying(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta) or 
        checkMarketNotBuyErrorDelta(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta)) &
        MarketActions_ = MarketActions &
        ActualActions_ = ActualActions &
        State_ = State &
        Check_ = Check.

operation(checkMarket).
dec_p_type(checkMarket(actions, set(stock), algstate, int, actions, set(stock), algstate, int, msj, rel(actions,set(stock)), int)).
checkMarket(MarketActions, ActualActions, State, Check, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, Delta):-
    checkMarketToBuyOk(State, Check, MarketActions, ActualActions, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, Delta)
    or 
    checkMarketNotBuyOk(State, Check, MarketActions, ActualActions, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, Delta)
    or 
    checkMarketErrors(State, Check, MarketActions, ActualActions, Msj, SelectTop3, Delta, MarketActions_, ActualActions_, State_, Check_).

%%%%%%%%%%%%%%%%%%%% CheckMarket %%%%%%%%%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%%%%%%% BuyActions %%%%%%%%%%%%%%%%%%%%%%%%
%BuyActionsOk
dec_p_type(buyActionsOk(algstate, int, actions, set(stock), actions, set(stock), algstate, int, msj, rel(actions,set(stock)), rel(set(value), value))).
buyActionsOk(State, Check, MarketActions, ActualActions, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, SumSet) :- 
    
    State = buying &
    
    Check = 0 &
    
    % Checkeo que haya fondos suficientes para comprar las acciones.
    
    % Valor de las acciones que poseo
    dres(ActualActions, MarketActions, S0) &
    dec(S0, actions) &

    ran(S0, R0) &
    dec(R0, set([value,alpha])) &

    dom(R0, D0) &
    dec(D0, set(value)) &

    applyTo(SumSet, D0, V0) &
    dec(V0, value) &

    % Valor de las acciones que quiero comprar
    applyTo(SelectTop3, MarketActions, Top3) &
    dec(Top3, set(stock)) &

    % Garantizo que las acciones estén efectivamente denro de MarketActions
    dom(MarketActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    subset(Top3, DomMkt) &

    dres(Top3, MarketActions, S1) &
    dec(S1, actions) &

    ran(S1, R1) &
    dec(R1, set([value,alpha])) &

    dom(R1, D1) &
    dec(D1, set(value)) &

    applyTo(SumSet, D1, V1) &
    dec(V1, value) &

    % Tengo que tener el suficiente dinero para comprar.
    V0 >= V1 &
    
    % Seteo las nuevas acciones adquiridas
    ActualActions_ = Top3 &
    
    % Las acciones de mercado se mantienen
    MarketActions_ = MarketActions &
    
    % El valor de Check se mantiene en 0 para que actualice de nuevo las acciones
    Check_ = Check &

    % Paso a analizar de nuevo     
    State_ = analyzing &

    Msj = ok.

%BuyActionsErrorNotBuying
dec_p_type(buyActionsErrorNotBuying(algstate, int, actions, set(stock),  msj, rel(actions,set(stock)), rel(set(value), value))).
buyActionsErrorNotBuying(State, Check, MarketActions, ActualActions ,Msj, SelectTop3, SumSet):-
    
    State = analyzing &
    Check = 0 &
    
    % Valor de las acciones que poseo
    dres(ActualActions, MarketActions, S0) &
    dec(S0, actions) &

    ran(S0, R0) &
    dec(R0, set([value,alpha])) &

    dom(R0, D0) &
    dec(D0, set(value)) &

    applyTo(SumSet, D0, V0) &
    dec(V0, value) &

    % Valor de las acciones que quiero comprar
    applyTo(SelectTop3, MarketActions, Top3) &
    dec(Top3, set(stock)) &

    % Garantizo que las acciones estén efectivamente denro de MarketActions
    dom(MarketActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    subset(Top3, DomMkt) &

    dres(Top3, MarketActions, S1) &
    dec(S1, actions) &

    ran(S1, R1) &
    dec(R1, set([value,alpha])) &

    dom(R1, D1) &
    dec(D1, set(value)) &

    applyTo(SumSet, D1, V1) &
    dec(V1, value) &

    % Tengo que tener el suficiente dinero para comprar.
    V0 >= V1 &

    Msj = errorBuyActionNotBuying.

%BuyActionsErrorNotFounds
dec_p_type(buyActionsErrorNotFounds(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), rel(set(value), value))).
buyActionsErrorNotFounds(State, Check, MarketActions, ActualActions ,Msj, SelectTop3 ,SumSet):-
    
    State = buying &
    Check = 0 &
    
    % Valor de las acciones que poseo
    dres(ActualActions, MarketActions, S0) &
    dec(S0, actions) &

    ran(S0, R0) &
    dec(R0, set([value,alpha])) &

    dom(R0, D0) &
    dec(D0, set(value)) &

    applyTo(SumSet, D0, V0) &
    dec(V0, value) &

    % Valor de las acciones que quiero comprar
    applyTo(SelectTop3, MarketActions, Top3) &
    dec(Top3, set(stock)) &

    % Garantizo que las acciones estén efectivamente denro de MarketActions
    dom(MarketActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    subset(Top3, DomMkt) &

    dres(Top3, MarketActions, S1) &
    dec(S1, actions) &

    ran(S1, R1) &
    dec(R1, set([value,alpha])) &

    dom(R1, D1) &
    dec(D1, set(value)) &

    applyTo(SumSet, D1, V1) &
    dec(V1, value) &

    % Tengo que tener el suficiente dinero para comprar.
    V0 < V1 &

    Msj = errorBuyActionNotFounds.


%BuyActionsErrorDelta
dec_p_type(buyActionsErrorDelta(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), rel(set(value), value))).
buyActionsErrorDelta(State, Check, MarketActions, ActualActions ,Msj, SelectTop3, SumSet):-
    
    State = buying &
    Check neq 0 &
    
    % Valor de las acciones que poseo
    dres(ActualActions, MarketActions, S0) &
    dec(S0, actions) &

    ran(S0, R0) &
    dec(R0, set([value,alpha])) &

    dom(R0, D0) &
    dec(D0, set(value)) &

    applyTo(SumSet, D0, V0) &
    dec(V0, value) &

    % Valor de las acciones que quiero comprar
    applyTo(SelectTop3, MarketActions, Top3) &
    dec(Top3, set(stock)) &

    % Garantizo que las acciones estén efectivamente denro de MarketActions
    dom(MarketActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    subset(Top3, DomMkt) &

    dres(Top3, MarketActions, S1) &
    dec(S1, actions) &

    ran(S1, R1) &
    dec(R1, set([value,alpha])) &

    dom(R1, D1) &
    dec(D1, set(value)) &

    applyTo(SumSet, D1, V1) &
    dec(V1, value) &

    % Tengo que tener el suficiente dinero para comprar.
    V0 >= V1 &

    Msj = errorBuyActionDeltaError.

%buyActionsErrorSelectTop3
dec_p_type(buyActionsErrorSelectTop3(algstate, int, actions, set(stock), msj, rel(actions,set(stock)), rel(set(value), value))).
buyActionsErrorSelectTop3(State, Check, MarketActions, ActualActions ,Msj, SelectTop3, SumSet):-
    State = buying &
    Check = 0 &
    
    % Valor de las acciones que poseo
    dres(ActualActions, MarketActions, S0) &
    dec(S0, actions) &

    ran(S0, R0) &
    dec(R0, set([value,alpha])) &

    dom(R0, D0) &
    dec(D0, set(value)) &

    applyTo(SumSet, D0, V0) &
    dec(V0, value) &

    % Valor de las acciones que quiero comprar
    applyTo(SelectTop3, MarketActions, Top3) &
    dec(Top3, set(stock)) &

    % No se garantiza que las acciones estén efectivamente dentro de MarketActions
    dom(MarketActions, DomMkt) &
    dec(DomMkt, set(stock)) &
    nsubset(Top3, DomMkt) &

    dres(Top3, MarketActions, S1) &
    dec(S1, actions) &

    ran(S1, R1) &
    dec(R1, set([value,alpha])) &

    dom(R1, D1) &
    dec(D1, set(value)) &

    applyTo(SumSet, D1, V1) &
    dec(V1, value) &

    % Tengo que tener el suficiente dinero para comprar.
    V0 >= V1 &

    Msj = errorBuyActionSelectTop3.


dec_p_type(buyActionsErrors(actions, set(stock), algstate, int, actions, set(stock), algstate, int, msj, rel(actions,set(stock)), rel(set(value), value))).
buyActionsErrors(MarketActions, ActualActions, State, Check, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3 ,SumSet):-
    
        (buyActionsErrorNotBuying(State, Check, MarketActions, ActualActions,  Msj, SelectTop3, SumSet) or
         buyActionsErrorNotFounds(State, Check, MarketActions, ActualActions,  Msj, SelectTop3, SumSet) or
         buyActionsErrorDelta(State, Check, MarketActions, ActualActions, Msj, SelectTop3, SumSet) or 
         buyActionsErrorSelectTop3(State, Check, MarketActions, ActualActions ,Msj, SelectTop3, SumSet)) &   
        MarketActions_ = MarketActions &
        ActualActions_ = ActualActions &
        State_ = State &
        Check_ = Check.

operation(buyActions).
dec_p_type(buyActions(actions, set(stock), algstate, int, actions, set(stock), algstate, int, msj, rel(actions,set(stock)), rel(set(value), value))).
buyActions(MarketActions, ActualActions, State, Check, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, SumSet):-

    buyActionsOk(State, Check, MarketActions, ActualActions , MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, SumSet)
    or
    buyActionsErrors(MarketActions, ActualActions, State, Check, MarketActions_, ActualActions_, State_, Check_, Msj, SelectTop3, SumSet).
%%%%%%%%%%%%%%%%%%%% BuyActions %%%%%%%%%%%%%%%%%%%%%%%%

% Fixing specification parameters
dec_p_type(q(int, rel(set(value),value), rel(actions,set(stock)))).
q(D, SS, ST3) :-
    D = 2 &
    % Definimos sumas para los conjuntos de valores que aparecerán
    % {10,7,6} = 23 (Top 3 inicial)
    % {90,3,10} = 103 (Segundo mercado)
    % {10,1,6} = 17 (Tercer mercado)
    SS = {[{},0], [{10,7,6},23], [{90,3,10},103], [{10,1,6},17], [{5,2,1},8]} &
    ST3 = { 
        % Si el mercado tiene s1,s2,s3,s4 -> elige s1,s2,s4 (suponiendo que son las mejores)
        [{[stock:s1,[10,1]],[stock:s2,[7,1]],[stock:s3,[2,1]],[stock:s4,[6,1]]}, {stock:s1,stock:s2,stock:s4}],
        % Si el mercado tiene x,y,z -> elige x,y,z
        [{[stock:x,[90,1]],[stock:y,[3,1]],[stock:z,[10,1]]}, {stock:x,stock:y,stock:z}],
        % Rotación: si vuelve el mercado a,b,c,d -> elige a,c,d
        [{[stock:a,[5,1]],[stock:b,[2,1]],[stock:c,[1,1]],[stock:d,[10,1]]}, {stock:a,stock:c,stock:d}]
    }.

dec_p_type(sim_init_noActions(actions, set(stock), algstate, int)).
sim_init_noActions(MarketActions, ActualActions, State, Check):-
    MarketActions = {} &
    ActualActions = {} & 
    State = analyzing &
    Check = 0.

dec_p_type(sim_init_3Actions(actions, set(stock), algstate, int)).
sim_init_3Actions(MarketActions, ActualActions, State, Check):-
    % Empezamos con 3 acciones que ya valen mucho (ej. 100)
    MarketActions = {[stock:s1,[50,1]], [stock:s2,[30,1]], [stock:s4,[20,1]]} &
    ActualActions = {stock:s1, stock:s2, stock:s4} & 
    State = analyzing &
    Check = 0.